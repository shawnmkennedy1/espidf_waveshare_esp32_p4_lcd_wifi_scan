{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build - Build Project",
            "command": "idf.py",
            "args": [
                "build"
            ],
            "options": {
                "env": {
                    "IDF_TARGET": "esp32p4"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Set Target to ESP32-P4",
            "command": "idf.py",
            "args": [
                "set-target",
                "esp32p4"
            ],
            "problemMatcher": []
        }
    ]
}